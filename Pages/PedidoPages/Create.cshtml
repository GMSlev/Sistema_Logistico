@page
@model Sistema_Logistico.Pages.PedidoPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Pedido</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Pedido.Cliente" class="control-label"></label>
                <input asp-for="Pedido.Cliente" class="form-control" aria-required="true"/>
                <span asp-validation-for="Pedido.Cliente" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Pedido.DataPedido" class="control-label"></label>
                <input asp-for="Pedido.DataPedido" class="form-control" aria-required="true"/>
                <span asp-validation-for="Pedido.DataPedido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Pedido.Status" class="control-label"></label>
                <select asp-for="Pedido.Status" class="form-select">
                    <option value="Pendente">Pendente</option>
                    <option value="Processando">Processando</option>
                    <option value="Enviado">Enviado</option>
                    <option value="Entregue">Entregue</option>
                </select>
                <span asp-validation-for="Pedido.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
