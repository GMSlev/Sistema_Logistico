@page
@model IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard Logístico</h2>

<div class="dashboard-cards">

    <div class="card-info">
        <h5>📦 Produtos</h5>
        <h2>@Model.TotalProdutos</h2>
    </div>

    <div class="card-info">
        <h5>🏭 Fornecedores</h5>
        <h2>@Model.TotalFornecedores</h2>
    </div>

    <div class="card-info">
        <h5>📋 Pedidos</h5>
        <h2>@Model.TotalPedidos</h2>
    </div>

    <div class="card-info">
        <h5>🚚 Entregas</h5>
        <h2>@Model.TotalEntregas</h2>
    </div>

    <div class="card-info">
        <h5>⚠️ Estoque Crítico</h5>
    <h2>@Model.EstoqueCritico</h2>
    </div>

</div>