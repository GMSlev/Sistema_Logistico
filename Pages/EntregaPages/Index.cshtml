@page
@model Sistema_Logistico.Pages.EntregaPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Entrega[0].Destino)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Entrega[0].DataEntrega)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Entrega[0].Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Entrega) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Destino)
            </td>
            <td>
                @Html.DisplayFor(model => item.DataEntrega)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
